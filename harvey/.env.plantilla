# Harvey · credenciales (copia a .env en la carpeta de cada instancia; nunca al repositorio)
# Buzón: elige UNA opción y pon channels.email.provider igual en harvey.local.yaml.
# Opción A · Google Workspace (recomendada): proyecto en Google Cloud → API de Gmail → credencial OAuth «Desktop app»
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Opción B · SMTP + IMAP (Fastmail, Workspace con contraseña de aplicación)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
# Verificador de correo (obligatorio para que envíe): Reoon tiene 600 comprobaciones gratis al mes
REOON_API_KEY=
# Opcionales
SERPER_API_KEY=            # 2.500 búsquedas gratis para descubrir negocios que OpenStreetMap no tiene
TRULYINBOX_API_KEY=        # lo pone `harvey trulyinbox connect`
PRECLEARED_API_KEY=        # comprobación legal por destinatario (25 al día gratis con clave)
