# Copia a .env.local para desarrollo. En Vercel, pon estas variables en Settings → Environment Variables.
NEXT_PUBLIC_URL=http://localhost:3000
# Neon: cadena con pooling y sin pooling (Neon las da las dos en "Connection details").
DATABASE_URL=postgresql://usuario:clave@host/nuevoenespana?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:clave@host/nuevoenespana?sslmode=require
# Stripe en modo prueba (sk_test_ y whsec_). El webhook apunta a /api/stripe/webhook
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Precios creados por scripts/stripe-configurar.mjs (opcionales: sin ellos se crean al vuelo con price_data)
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_PACK=
# Resend (correo). Sin clave, los correos se escriben en el registro del servidor y no se envían.
RESEND_API_KEY=
CORREO_REMITENTE="Nuevo en España <noreply@numimates.com>"
# Secreto para firmar enlaces de acceso y la cookie de sesión (32+ caracteres aleatorios).
SECRETO_SESION=cambia-esto-por-un-secreto-largo-y-aleatorio
# Protege /api/cron/* (Vercel lo envía como Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=cambia-esto
# Titular (aviso legal y condiciones). Si faltan, se usa config/paises/es.json
LEGAL_NOM=
LEGAL_NIF=
LEGAL_EMAIL=
LEGAL_ADRECA=
# Analítica sin cookies (opcional): dominio de Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
