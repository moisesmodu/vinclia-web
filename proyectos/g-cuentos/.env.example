# ── Lo que pega Moisés (PARA-MOISES.md) ─────────────────────────────
# Neon (Postgres): "Connection string" pooled y directa
DATABASE_URL="postgresql://usuario:clave@ep-xxx-pooler.eu-central-1.aws.neon.tech/lunilla?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@ep-xxx.eu-central-1.aws.neon.tech/lunilla?sslmode=require"
# Stripe (modo prueba primero: sk_test_… y el secreto del webhook whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Gelato (impresión). GELATO_MODO=borrador crea pedidos en borrador (sandbox); produccion = pedidos reales.
GELATO_API_KEY=
GELATO_MODO=borrador
# ── Claves de cuentas que ya existen ─────────────────────────────────
ANTHROPIC_API_KEY=          # texto con claude-sonnet-5-5 (sin clave: texto de plantilla)
RESEND_API_KEY=             # correos (sin clave: se guardan en disco)
CORREO_REMITENTE="Lunilla <hola@lunilla.es>"
CORREO_SOPORTE=hola@lunilla.es
# ── Automáticas / generadas ──────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=      # la crea Vercel al conectar un Blob store
CRON_SECRET=                # la crea Vercel para los cron
ADMIN_TOKEN=                # 32+ caracteres aleatorios: panel /admin?t=… y API de la tarea programada
URL_BASE=https://lunilla.vercel.app
PAIS=ES
