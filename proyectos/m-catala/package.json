{
  "name": "aprova-catala",
  "version": "1.0.0",
  "private": true,
  "description": "Aprova: la app para aprobar los certificados oficiales de catalán (B1 a C2). Proyecto M de la cartera.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-preparar.mjs && node motor/compilar.mjs && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "comprobar": "node motor/comprobar.mjs",
    "compilar": "node motor/compilar.mjs",
    "validar": "node motor/validar-lt.mjs",
    "generar": "node motor/generar.mjs",
    "iconos": "node scripts/iconos.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "stripe": "23.0.1",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "opentype.js": "^1.3.4",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
