# Neon (proyecto cartera-m-catala)
DATABASE_URL="postgresql://usuario:clave@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"
# Stripe, cuenta Numi Mates (DESPLIEGUES.md §2). Productos y precios: scripts/stripe-preparar.mjs o la propia app.
STRIPE_TEST_SECRET_KEY="sk_test_..."
STRIPE_SECRET_KEY="rk_live_..."
STRIPE_MODO="prueba"            # "real" para cobrar de verdad
STRIPE_WEBHOOK_SECRET=""        # lo imprime scripts/stripe-preparar.mjs (opcional)
# Correo (alertas de convocatoria, recuperación de contraseña, informe semanal)
RESEND_API_KEY=""
CORREO_REMITENTE="Aprova <noreply@numimates.com>"
# Titular para los textos legales
LEGAL_NOM=""
LEGAL_NIF=""
LEGAL_EMAIL="hola@numimates.com"
LEGAL_ADRECA=""
# Sesión y URL pública
AUTH_SECRET=""
NEXT_PUBLIC_URL="https://aprova-catala.vercel.app"
# Corrección escrita por criterios (adecuación, coherencia, riqueza) y generación de ítems.
# Orden de preferencia: BSC_API_URL (Salamandra/ALIA, endpoint compatible con OpenAI) > ANTHROPIC_API_KEY. Sin ninguna: solo reglas + LanguageTool.
BSC_API_URL=""
BSC_API_KEY=""
BSC_MODEL="BSC-LT/salamandra-7b-instruct"
ANTHROPIC_API_KEY=""
# LanguageTool con las reglas de Softcatalà. Por defecto la API pública (20 peticiones/min); en local: http://localhost:8081/v2
LANGUAGETOOL_URL="https://api.languagetool.org/v2"
# Voz. TTS: "navegador" (gratis, voz del móvil), "google" (GOOGLE_TTS_API_KEY), "azure" (AZURE_TTS_KEY + AZURE_TTS_REGION), "matxa" (MATXA_URL). ElevenLabs solo en la demo de la landing.
TTS_PROVEIDOR="navegador"
GOOGLE_TTS_API_KEY=""
AZURE_TTS_KEY=""
AZURE_TTS_REGION="westeurope"
MATXA_URL=""
ELEVENLABS_API_KEY=""
# Reconocimiento de voz para la oral: endpoint de Whisper catalán (projecte-aina) compatible con /v1/audio/transcriptions. Sin él, Web Speech del navegador.
WHISPER_URL=""
WHISPER_API_KEY=""
