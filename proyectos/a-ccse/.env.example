# URL pública (sin barra final). En Vercel: la del dominio o la *.vercel.app
NEXT_PUBLIC_SITE_URL=https://ccse-en-tu-idioma.vercel.app
# Neon (Vercel lo rellena solo si se conecta la integración de Neon)
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
# Secreto para firmar la sesión (cadena aleatoria de 32+ caracteres)
AUTH_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
# Stripe en modo prueba: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Opcional: si se deja vacío, la app crea el webhook sola en el primer pago y guarda el secreto en la base de datos
STRIPE_WEBHOOK_SECRET=
# Opcional: correo para recuperar contraseña (Resend). Sin él, la recuperación se hace por soporte.
RESEND_API_KEY=
CORREO_REMITENTE=CCSE en tu idioma <hola@example.com>
# Datos legales del titular (aviso legal)
LEGAL_TITULAR=Moisés Mora
LEGAL_NIF=
LEGAL_DOMICILIO=Lleida (España)
LEGAL_EMAIL=
# Android (TWA): huellas SHA-256 separadas por comas (la de subida y la de firma de Google Play)
TWA_SHA256=
TWA_PACKAGE=es.nuevoenespana.ccse
