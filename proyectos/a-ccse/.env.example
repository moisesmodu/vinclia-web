# Todas las variables y su origen están en DESPLIEGUE.md (y las comunes de la cartera en ../../DESPLIEGUES.md).
NEXT_PUBLIC_SITE_URL=https://ccse-en-tu-idioma.vercel.app
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
AUTH_SECRET=
# Stripe, cuenta Numi Mates: desarrollo con la de prueba; STRIPE_MODO=live usa STRIPE_SECRET_KEY
STRIPE_MODO=test
STRIPE_TEST_SECRET_KEY=
STRIPE_SECRET_KEY=
# Opcional: sin él, la app crea el webhook en el primer pago y guarda el secreto en la base de datos
STRIPE_WEBHOOK_SECRET=
# Opcional: recuperar contraseña por correo
RESEND_API_KEY=
CORREO_REMITENTE=CCSE en tu idioma <noreply@numimates.com>
# Titular (aviso legal, privacidad, condiciones). Se leen en cada petición; si faltan se ve «[falta LEGAL_…]»
LEGAL_NOM=
LEGAL_NIF=
LEGAL_EMAIL=hola@numimates.com
LEGAL_ADRECA=
# Android (TWA): huella de la clave de subida y la de firma de Google Play, separadas por comas
TWA_SHA256=
TWA_PACKAGE=es.nuevoenespana.ccse
# Search Console (etiqueta HTML)
GOOGLE_SITE_VERIFICATION=
# Analítica sin cookies (opcional)
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=
