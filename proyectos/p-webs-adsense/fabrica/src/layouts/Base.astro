---
// Plantilla de todas las páginas: SEO (canónica, hreflang, Open Graph, datos estructurados), colores del sitio,
// consentimiento de Google (TCF 2.2) y AdSense solo si hay cuenta, y Umami (analítica sin cookies).
import '../styles/base.css';
import '../styles/calc.css';
import '../styles/paginas.css';
import type { Lang } from '../lib/def';
import { sitio, anunciosActivos, pubId, SITIO_ID } from '../lib/sitio';
import { url, absoluta, buscar } from '../lib/rutas';
import { UI } from '../lib/ui';
import familia from '../../familia.json';
// Tipografías de la familia Claro alojadas en el propio sitio (sin peticiones a Google): Manrope 700 e Inter 400/600
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';

interface Props {
  lang: Lang;
  titulo: string;
  descripcion: string;
  ruta: string;
  alternas: Partial<Record<Lang, string>>;
  jsonld?: object[];
  actual?: 'inicio' | 'datos' | 'sobre';
}
const { lang, titulo, descripcion, ruta, alternas, jsonld = [], actual } = Astro.props;
const u = UI[lang];
const c = sitio.colores;
const vars = `:root{--primario:${c.primario};--primarioOscuro:${c.primarioOscuro};--marca:${c.marca};--acento:${c.acento};--cabecera:${c.cabecera};--fondo:${c.fondo};--tenue:${c.tenue};--superficie:${c.superficie};--tinta:${c.tinta};--suave:${c.suave};--borde:${c.borde}}`
  // font-display: optional evita cualquier salto de diseño (CLS 0): si la letra no llega a tiempo, se usa la del sistema
  + `@font-face{font-family:Manrope;font-weight:700;font-display:optional;src:url(${manrope700}) format('woff2')}`
  + `@font-face{font-family:Inter;font-weight:400;font-display:optional;src:url(${inter400}) format('woff2')}`
  + `@font-face{font-family:Inter;font-weight:600;font-display:optional;src:url(${inter600}) format('woff2')}`;
const mc = sitio.marcaClaro;
// Marca de la familia Claro: una C abierta con una línea de horizonte (marcas/logos/p-webs-adsense-icono.svg)
const marcaSvg = (horizonte: string) => `<svg viewBox="0 0 56 56" width="32" height="32" aria-hidden="true" focusable="false"><path d="M44 16a20 20 0 1 0 0 24" stroke="${c.marca}" stroke-width="9" fill="none" stroke-linecap="round"/><rect x="26" y="25" width="26" height="6" rx="3" fill="${horizonte}"/></svg>`;
const otra: Lang = lang === 'es' ? 'ca' : 'es';
const inicio = buscar('inicio', lang)!;
const datos = buscar('fichas', lang)!;
const sobre = buscar('legal:sobre', lang)!;
const favicon = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56 56"><rect width="56" height="56" rx="12" fill="#FFFFFF"/><path d="M44 16a20 20 0 1 0 0 24" stroke="${c.marca}" stroke-width="9" fill="none" stroke-linecap="round"/><rect x="26" y="25" width="26" height="6" rx="3" fill="${c.tinta}"/></svg>`)}`;
const ads = anunciosActivos();
const cliente = sitio.adsense.cliente;
const titCompleto = titulo.includes(sitio.nombre) ? titulo : `${titulo} | ${sitio.nombre}`;
const anio = new Date().getFullYear();
// Sitios hermanos de la familia Claro (familia.json): el visitante salta al que le interesa
const hermanos = familia.sitios.filter((x) => x.id !== SITIO_ID && x.estado === 'activo' && x.url);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={absoluta(ruta)} />
  {Object.entries(alternas).map(([l, r]) => <link rel="alternate" hreflang={l} href={absoluta(r!)} />)}
  {alternas.es !== undefined && <link rel="alternate" hreflang="x-default" href={absoluta(alternas.es)} />}
  <meta name="theme-color" content={c.primario} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={sitio.nombre} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={absoluta(ruta)} />
  <meta property="og:locale" content={((import.meta.env.LOCALES as Record<string, string> | undefined)?.[lang] ?? (lang === 'es' ? 'es-ES' : 'ca-ES')).replace('-', '_')} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="preload" href={manrope700} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
  {sitio.searchConsole.verificacion && <meta name="google-site-verification" content={sitio.searchConsole.verificacion} />}
  <style set:html={vars}></style>
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  {ads && (
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});
(function(){var c=${JSON.stringify(cliente)},p=${JSON.stringify(pubId())},h=0;function a(s,x){var e=document.createElement('script');e.async=true;e.src=s;if(x)e.crossOrigin='anonymous';document.head.appendChild(e)}
function cargar(){if(h)return;h=1;a('https://fundingchoicesmessages.google.com/i/'+p+'?ers=1');
(function(){function s(){if(!window.frames.googlefcPresent){if(document.body){var i=document.createElement('iframe');i.style.cssText='width:0;height:0;border:none;z-index:-1000;left:-1000px;top:-1000px;display:none';i.name='googlefcPresent';document.body.appendChild(i)}else{setTimeout(s,0)}}}s()})();
a('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+c,1);
document.querySelectorAll('ins.adsbygoogle').forEach(function(){(window.adsbygoogle=window.adsbygoogle||[]).push({})})}
['scroll','pointerdown','keydown','touchstart'].forEach(function(e){addEventListener(e,cargar,{once:true,passive:true})});
addEventListener('load',function(){setTimeout(cargar,3000)})})();`} />
  )}
  {sitio.umami.id && <script is:inline defer src={sitio.umami.src} data-website-id={sitio.umami.id} data-do-not-track="true"></script>}
</head>
<body>
  <a class="saltar" href="#contenido">{u.saltar}</a>
  <header class="cab">
    <div class="env">
      <a class="logo" href={url(inicio.ruta)} aria-label={`${sitio.nombre}: ${u.inicio}`}><Fragment set:html={marcaSvg('#FFFFFF')} /><span>{mc.partes[0]}<b>{mc.partes[1]}</b></span></a>
      <nav class="nav" aria-label={u.menu}>
        <a href={url(inicio.ruta) + '#calculadoras'} aria-current={actual === 'inicio' ? 'page' : undefined}>{u.calculadoras}</a>
        <a href={url(datos.ruta)} aria-current={actual === 'datos' ? 'page' : undefined}>{u.datos}</a>
        {alternas[otra] !== undefined && <a class="idioma" href={url(alternas[otra]!)} hreflang={otra} lang={otra} title={u.cambiarIdioma}>{u.idioma}</a>}
      </nav>
    </div>
  </header>
  <main id="contenido" class="env">
    <slot />
  </main>
  <footer class="pie">
    <div class="env">
      <div>
        <p class="pie-marca"><Fragment set:html={marcaSvg('#FFFFFF')} /><span>{mc.partes[0]}<b>{mc.partes[1]}</b></span></p>
        <p class="promesa">{mc.promesa[lang]}</p>
        <p>{sitio.lema[lang]}.</p>
        <p class="sello">{mc.sello[lang]}</p>
        <p>© {anio} {sitio.titular.nombre} · <a href={url(sobre.ruta)}>{u.legal.sobre}</a></p>
      </div>
      <div>
        <h2>{u.datos}</h2>
        <ul>
          <li><a href={url(datos.ruta)}>{u.todas}</a></li>
          <li><a href={url(inicio.ruta) + '#calculadoras'}>{u.calculadoras}</a></li>
        </ul>
      </div>
      {hermanos.length > 0 && (
        <div>
          <h2>{lang === 'ca' ? 'Família Claro' : 'Familia Claro'}</h2>
          <ul class="familia">
            {hermanos.map((x) => <li><a href={x.url + (lang !== 'es' && x.idiomas.includes(lang) ? `/${lang}/` : '/')}><b>{x.nombre}</b><span>{x.interes[lang] ?? x.interes.es}</span></a></li>)}
            {familia.portal.url && <li><a href={familia.portal.url + '/'}><b>CalculaClaro</b><span>{lang === 'ca' ? 'Totes les calculadores de la família' : 'Todas las calculadoras de la familia'}</span></a></li>}
          </ul>
        </div>
      )}
      <div>
        <h2>Legal</h2>
        <ul>
          <li><a href={url(buscar('legal:aviso', lang)!.ruta)}>{u.legal.aviso}</a></li>
          <li><a href={url(buscar('legal:privacidad', lang)!.ruta)}>{u.legal.privacidad}</a></li>
          <li><a href={url(buscar('legal:cookies', lang)!.ruta)}>{u.legal.cookies}</a></li>
          {ads && <li><button type="button" id="gestionar-cookies">{u.legal.gestionar}</button></li>}
        </ul>
      </div>
    </div>
  </footer>
  {ads && <script is:inline set:html={`document.getElementById('gestionar-cookies')?.addEventListener('click',function(){window.googlefc=window.googlefc||{};googlefc.callbackQueue=googlefc.callbackQueue||[];googlefc.callbackQueue.push({'CONSENT_DATA_READY':function(){googlefc.showRevocationMessage()}});dispatchEvent(new Event('scroll'))})`} />}
</body>
</html>
