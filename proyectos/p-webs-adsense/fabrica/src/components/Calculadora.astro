---
// Formulario + resultado de una calculadora. El resultado con los valores por defecto se calcula en el
// servidor, así la página tiene un ejemplo real sin JavaScript y el LCP es texto estático.
import { t, valoresPorDefecto, type DefCalc, type Lang } from '../lib/def';
import { renderResultado } from '../lib/render';
import { params } from '../lib/params';
import { UI } from '../lib/ui';

interface Props { d: DefCalc; lang: Lang; pais: string; anio: number; anios: number[]; provisionales: number[] }
const { d, lang, pais, anio, anios, provisionales } = Astro.props;
const v = valoresPorDefecto(d, anio);
const resultado = d.calcular(v, { P: params(pais, anio), lang, pais });
const html = renderResultado(resultado, lang);
const u = UI[lang];
const FAMILIA = ['situacion', 'edad', 'hijos', 'menores3', 'enteros', 'discapacidad'];
const principales = d.campos.filter((c) => !FAMILIA.includes(c.id));
const familiares = d.campos.filter((c) => FAMILIA.includes(c.id));
const grupos = [{ campos: principales, det: false }, ...(familiares.length ? [{ campos: familiares, det: true }] : [])];
---
<section class="calc" data-calc={d.id} data-lang={lang} data-pais={pais} data-anio={anio} aria-labelledby="calc-t">
  <h2 id="calc-t" class="vh">{u.calculadora}</h2>
  <form class="calc-form" novalidate>
    {d.anual && (
      <div class="campo campo-anio">
        <label for="f-anio">{u.anio}</label>
        <select id="f-anio" name="anio">
          {anios.map((a) => <option value={a} selected={a === anio}>{a}{provisionales.includes(a) ? ` (${u.provisional})` : ''}</option>)}
        </select>
      </div>
    )}
    {grupos.map((g) => g.det ? (
      <details class="grupo-fam">
        <summary>{lang === 'es' ? 'Situación personal y familiar (opcional)' : 'Situació personal i familiar (opcional)'}</summary>
        <div class="grupo-campos">
{g.campos.map((c) => (
      <div class={`campo campo-${c.tipo}`} data-campo={c.id} hidden={c.si ? !c.si(v) : false}>
        {c.tipo === 'casilla' ? (
          <label class="casilla"><input type="checkbox" id={`f-${c.id}`} name={c.id} checked={c.def} /> <span>{t(c.etiqueta, lang)}</span></label>
        ) : (
          <label for={`f-${c.id}`}>{t(c.etiqueta, lang)}</label>
        )}
        {c.tipo === 'numero' && (
          <div class="entrada">
            <input type="number" inputmode="decimal" id={`f-${c.id}`} name={c.id} value={c.def} min={c.min} max={c.max} step={c.paso ?? 'any'} />
            {c.sufijo && <span class="sufijo" aria-hidden="true">{c.sufijo}</span>}
          </div>
        )}
        {c.tipo === 'select' && (
          <select id={`f-${c.id}`} name={c.id}>
            {c.opciones.map((o) => <option value={o.v} selected={o.v === c.def}>{t(o.t, lang)}</option>)}
          </select>
        )}
        {c.tipo === 'fecha' && <input type="date" id={`f-${c.id}`} name={c.id} value={c.def} />}
        {c.ayuda && <small class="ayuda">{t(c.ayuda, lang)}</small>}
      </div>
    ))}
        </div>
      </details>
    ) : (
      <Fragment>
{g.campos.map((c) => (
      <div class={`campo campo-${c.tipo}`} data-campo={c.id} hidden={c.si ? !c.si(v) : false}>
        {c.tipo === 'casilla' ? (
          <label class="casilla"><input type="checkbox" id={`f-${c.id}`} name={c.id} checked={c.def} /> <span>{t(c.etiqueta, lang)}</span></label>
        ) : (
          <label for={`f-${c.id}`}>{t(c.etiqueta, lang)}</label>
        )}
        {c.tipo === 'numero' && (
          <div class="entrada">
            <input type="number" inputmode="decimal" id={`f-${c.id}`} name={c.id} value={c.def} min={c.min} max={c.max} step={c.paso ?? 'any'} />
            {c.sufijo && <span class="sufijo" aria-hidden="true">{c.sufijo}</span>}
          </div>
        )}
        {c.tipo === 'select' && (
          <select id={`f-${c.id}`} name={c.id}>
            {c.opciones.map((o) => <option value={o.v} selected={o.v === c.def}>{t(o.t, lang)}</option>)}
          </select>
        )}
        {c.tipo === 'fecha' && <input type="date" id={`f-${c.id}`} name={c.id} value={c.def} />}
        {c.ayuda && <small class="ayuda">{t(c.ayuda, lang)}</small>}
      </div>
    ))}
      </Fragment>
    ))}
    <noscript><p class="ayuda">{u.sinJs}</p></noscript>
  </form>
  <div class="calc-out">
    <div class="res" aria-live="polite" set:html={html} />
    <div class="calc-acciones">
      <button type="button" data-accion="compartir" class="btn-sec"><span class="ok-no">{u.compartir}</span><span class="ok-si">{u.copiado}</span></button>
      <button type="button" data-accion="imprimir" class="btn-sec">{u.imprimir}</button>
    </div>
  </div>
</section>
<script>
  import '../lib/cliente';
</script>
