{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run publicar",
  "outputDirectory": "publicar",
  "trailingSlash": true,
  "headers": [
    { "source": "/_a/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/descarga/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Cache-Control", "value": "private, no-store" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
