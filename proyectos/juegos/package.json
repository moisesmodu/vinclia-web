{
  "name": "juegos",
  "private": true,
  "type": "module",
  "description": "Catálogo de juegos HTML5 (Phaser 3 + TypeScript + Vite) para CrazyGames, Poki e itch.io",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs web",
    "build:todo": "node scripts/build.mjs all",
    "paquetes": "node scripts/build.mjs all && node scripts/package.mjs",
    "nuevo": "node scripts/new-game.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:rendimiento": "node scripts/perf.mjs",
    "test:sdk": "node scripts/sdk-test.mjs crazygames && node scripts/sdk-test.mjs poki"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.0"
  }
}
