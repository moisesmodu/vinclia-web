-- Pruebas de src/shared/Rocket.luau: velocidades, alcance, combustible, techo y radio de vuelo.

local Config = require("../src/shared/Config")
local Rocket = require("../src/shared/Rocket")

return function(T)
	T.section("Rocket")
	local p = Config.Rocket

	T.test("velocidades con y sin el pase Faster Rocket", function()
		local s = Rocket.speeds(p, false)
		T.eq(s.climb, 20)
		T.eq(s.fall, 9)
		T.eq(s.horizontal, 24)
		local f = Rocket.speeds(p, true)
		T.eq(f.climb, 30)
		T.eq(f.fall, 13.5)
		T.eq(f.horizontal, 36)
	end)

	T.test("velocidad máxima (diagonal subiendo)", function()
		T.near(Rocket.maxSpeed(p, false), math.sqrt(976), 1e-9)
		T.near(Rocket.maxSpeed(p, true), math.sqrt(976) * 1.5, 1e-9)
	end)

	T.test("alcance: radio, techo y reserva de combustible", function()
		T.eq(Rocket.climbReach(p), 72, "80 de depósito, pero el techo es 72")
		T.eq(Rocket.canReach(p, 10, 64), true, "64 = 20 · 4 · 0.8")
		T.eq(Rocket.canReach(p, 10, 64.1), false)
		T.eq(Rocket.canReach(p, 70, 10), true)
		T.eq(Rocket.canReach(p, 70.1, 10), false, "fuera del radio")
		T.eq(Rocket.canReach(p, -1, 0), false)
		T.eq(Rocket.canReach(p, 0, 73), false, "por encima del techo")
	end)

	T.test("combustible: se gasta empujando", function()
		local fuel, thrust = Rocket.stepFuel(4, true, false, 1, p)
		T.eq(fuel, 3)
		T.eq(thrust, true)
		local f2, t2 = Rocket.stepFuel(0.5, true, false, 1, p)
		T.eq(f2, 0)
		T.eq(t2, true)
		local f3, t3 = Rocket.stepFuel(0, true, true, 1, p)
		T.eq(f3, 0, "vacío: no hay empuje")
		T.eq(t3, false)
	end)

	T.test("combustible: se rellena posado y no en el aire", function()
		local fuel = Rocket.stepFuel(2, false, true, 1, p)
		T.eq(fuel, 3.5)
		T.eq((Rocket.stepFuel(3.9, false, true, 1, p)), 4, "tope")
		T.eq((Rocket.stepFuel(2, false, false, 1, p)), 2, "planeando no se rellena")
		T.eq((Rocket.stepFuel(10, false, false, 0, p)), 4, "nunca más del depósito")
	end)

	T.test("velocidad vertical: sube, techo y planeo", function()
		local s = Rocket.speeds(p, false)
		T.eq(Rocket.verticalVelocity(true, 10, s, p), 20)
		T.eq(Rocket.verticalVelocity(true, 72, s, p), 0, "en el techo no sube más")
		T.eq(Rocket.verticalVelocity(false, 40, s, p), -9)
	end)

	T.test("radio de vuelo: fuera se quita lo que aleja", function()
		local vx, vz = Rocket.clampHorizontal(10, 0, 5, 3, 70)
		T.eq(vx, 5, "dentro no cambia")
		T.eq(vz, 3)
		vx, vz = Rocket.clampHorizontal(80, 0, 5, 3, 70)
		T.eq(vx, 0, "fuera: sin la parte que aleja")
		T.eq(vz, 3, "la de lado se queda")
		vx, vz = Rocket.clampHorizontal(80, 0, -5, 3, 70)
		T.eq(vx, -5, "volver hacia dentro sí")
		vx, vz = Rocket.clampHorizontal(0, 90, 2, 4, 70)
		T.eq(vx, 2)
		T.eq(vz, 0)
		vx, vz = Rocket.clampHorizontal(60, 80, 6, 8, 70)
		T.near(vx, 0, 1e-9)
		T.near(vz, 0, 1e-9)
	end)
end
