{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@comun/*": ["comun/*"] },
    "types": ["node"]
  },
  "include": ["comun", "*/src", "*/vite.config.ts", "scripts/*.d.ts"]
}
