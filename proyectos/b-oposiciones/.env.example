# Neon (la integración de Neon en Vercel las crea sola)
DATABASE_URL="postgresql://usuario:clave@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Stripe (modo prueba: sk_test_…). Los productos y precios los crea la app sola.
STRIPE_SECRET_KEY="sk_test_..."
# Opcional: webhook (Stripe → Developers → Webhooks → https://<dominio>/api/stripe/webhook). Sin él, la app se sincroniza sola.
STRIPE_WEBHOOK_SECRET=""
# Opcional: URL pública si hay dominio propio
NEXT_PUBLIC_URL=""
# Opcional: secreto de sesión propio (si no, se deriva de las otras claves)
AUTH_SECRET=""
# Solo para el motor en modo API
ANTHROPIC_API_KEY=""
